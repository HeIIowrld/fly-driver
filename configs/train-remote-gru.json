{
  "purpose": "initial remote GPU learning on synthetic 3D terrain; sensor-only prototype",
  "device": "cuda:0",
  "seed": 3001,
  "start_x_range": [3.0, 80.0],
  "policy": "gru",
  "num_envs": 8,
  "torch_threads": 4,
  "horizon": 256,
  "updates": 16,
  "epochs": 4,
  "checkpoint_interval": 2,
  "learning_rate": 0.0003,
  "gamma": 0.99,
  "gae_lambda": 0.95,
  "clip": 0.2,
  "environment": {
    "mode": "V",
    "max_steps": 2000,
    "image_size": 32,
    "control_dt": 0.01,
    "physics_dt": 0.001,
    "camera_hz": 30,
    "road": {
      "length": 100.0,
      "width": 6.0,
      "grade": 0.02,
      "hill_amplitude": 0.6,
      "hill_period": 70.0,
      "bank_degrees": 6.0,
      "turn_amplitude": 2.0,
      "turn_period": 70.0,
      "bump_height": 0.03,
      "flattened": false
    }
  }
}
